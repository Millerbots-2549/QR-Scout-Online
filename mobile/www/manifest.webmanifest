{
  "name": "2549 Millerbots Scouting — QR Scout Online",
  "short_name": "QR Scout",
  "description": "Free FRC scouting app for Team 2549 Millerbots and any FIRST Robotics team. Collect match scouting data with QR codes and sync it to Google Sheets.",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",

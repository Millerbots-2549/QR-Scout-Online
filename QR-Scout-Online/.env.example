PORT=3001
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
SHEET_NAME=Scouting

# Feedback tab: submissions are saved to the Feedback tab of GOOGLE_SHEET_ID and
# emailed to the owner by the browser through FormSubmit (free; the first
# submission triggers a one-time activation email to the owner). SMTP below is
# an optional extra direct-email path from the backend.
# FEEDBACK_SHEET_NAME=Feedback
# FEEDBACK_TO_EMAIL=your_email_here
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_smtp_username_here
# SMTP_PASS=your_smtp_password_here
